{
  "name": "@bhaikidukaan/product-service",
  "version": "1.0.0",
  "private": true,
  "description": "Product catalog, search & inventory gRPC microservice",
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/db/seed.ts",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@bhaikidukaan/proto-gen": "*",
    "@grpc/grpc-js": "^1.12.0",
    "@grpc/proto-loader": "^0.7.13",
    "dotenv": "^16.4.0",
    "kafkajs": "^2.2.4",
    "mongoose": "^8.9.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
