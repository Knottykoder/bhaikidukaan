# ============================================
# User Service — Environment Variables
# ============================================

# gRPC Server
GRPC_PORT=50051
GRPC_HOST=0.0.0.0

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bhaikidukaan_users
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bhaikidukaan_users

# JWT Secrets (change in production!)
JWT_ACCESS_SECRET=bhai-ki-dukaan-access-secret-change-me
JWT_REFRESH_SECRET=bhai-ki-dukaan-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Environment
NODE_ENV=development
