{
  "name": "bhaikidukaan",
  "version": "1.0.0",
  "private": true,
  "description": "Full-stack gRPC ecommerce platform — BhaiKiDukaan",
  "workspaces": [
    "packages/*",
    "services/*",
    "web"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "proto:generate": "bash scripts/generate-proto.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "docker:up": "docker compose up --build -d",
    "docker:down": "docker compose down",
    "docker:infra": "docker compose -f docker-compose.infra.yml up -d",
    "docker:infra:down": "docker compose -f docker-compose.infra.yml down",
    "docker:logs": "docker compose logs -f"
  },
  "overrides": {
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/connect": "1.7.0",
    "@connectrpc/connect-web": "1.7.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protoc-gen-es": "^1.10.1",
    "@connectrpc/protoc-gen-connect-es": "^1.7.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.8.0"
}
